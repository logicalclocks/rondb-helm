# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Written into the chart root by the publish_chart action before
# `helm package`, for the gh-pages README
values.schema.md
# Used from a git checkout only. Templates read chart files from files/
.github/
docs/
test_scripts/
values/
standalone_deps.sh
# Created by the README's `.github/requirements.txt` setup
venv/
